# ==============================================================================
# SECURE BANKING & FINANCE ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide deployment-specific values.
# NEVER commit real credentials, secret keys, or private tokens into version control.

# --- Application Core Settings ---
APP_NAME=secure-finance-assistant
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# --- Microsoft Entra ID (Azure AD) Authentication ---
# In production, tokens are validated against Microsoft Entra ID OpenID Connect / JWKS endpoints.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=api://secure-finance-assistant
ENTRA_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
ENTRA_JWKS_CACHE_TTL_SECONDS=86400

# Mock Auth Mode: Set to 'true' ONLY in isolated dev/test environments without live Entra ID connectivity.
# When true, static test public keys or mock bearer tokens signed by test harness can be evaluated.
AUTH_MOCK_ENABLED=false

# --- PostgreSQL Database (Audit Trail & Token Vault) ---
# Separate read/write or connection pool credentials
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=secure_banking
POSTGRES_USER=app_audit_writer
POSTGRES_PASSWORD=replace_with_secure_postgres_password
DATABASE_URL=postgresql+asyncpg://app_audit_writer:replace_with_secure_postgres_password@localhost:5432/secure_banking
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_TIMEOUT_SECONDS=10

# Audit Fail-Safe Mode:
# When true, the API strictly returns HTTP 500 if the PostgreSQL audit event write fails.
AUDIT_STRICT_FAIL_SAFE=true

# --- Amazon Bedrock & Guardrails ---
AWS_REGION=us-east-1
# Bedrock Model ID (e.g., anthropic.claude-3-haiku-20240307-v1:0 or amazon.nova-micro-v1:0)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Bedrock Guardrail identifier and version (must exist in configured AWS account/region)
BEDROCK_GUARDRAIL_ID=gr-example123456
BEDROCK_GUARDRAIL_VERSION=1
BEDROCK_INVOCATION_TIMEOUT_SECONDS=30
# Custom Private VPC Endpoint for Bedrock Runtime (empty string uses standard AWS routing)
BEDROCK_ENDPOINT_URL=

# Mock Bedrock Mode: Set to 'true' ONLY in isolated dev/test environments without AWS connectivity.
BEDROCK_MOCK_ENABLED=false

# --- Token Vault & Cryptographic Key Management ---
# Provider: 'kms' (AWS KMS envelope encryption) or 'local_envelope' (AES-256-GCM dev fallback)
TOKEN_VAULT_KEY_PROVIDER=kms
# AWS KMS Key ARN used for token envelope encryption
TOKEN_VAULT_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000
# For local_envelope dev mode ONLY (base64-encoded 256-bit key). DO NOT USE IN PRODUCTION.
TOKEN_VAULT_LOCAL_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
TOKEN_VAULT_DEFAULT_EXPIRY_DAYS=90

# --- Guardrails & Content Policy Parameters ---
MAX_INPUT_TEXT_LENGTH=4000
PROCEDURE_DOCS_DIRECTORY=data/banking_procedures
ENABLE_PROMPT_INJECTION_FILTER=true
ENABLE_OUTPUT_SAFETY_FILTER=true
